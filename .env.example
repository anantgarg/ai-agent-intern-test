# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional overrides
# Examples: openai/gpt-4o-mini, openai/gpt-4o, anthropic/claude-sonnet-4, google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o-mini
DEBUG=0
MAX_HISTORY_TURNS=8
RETRIEVAL_TOP_K=6
